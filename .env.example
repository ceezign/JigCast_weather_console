
# Get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# metric = Celsius / m/s, imperial = Fahrenheit / mph
WEATHER_UNITS=metric

# Local dev only — leave false/unset in production
FLASK_DEBUG=false

# Port the app listens on (Render sets this automatically)
PORT=5000

LOG_LEVEL=INFO
